+ Host ------------------------- localhost:9094 ----> Kafka Broker
+ Container (Same Network) ----- kafka:9092 --------> Kafka Broker

podman run --network=ps --name n8n -e N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true -e N8N_RUNNERS_ENABLED=true -p 5678:5678 -v /mnt/c/podman/n8n/data:/home/node/.n8n -d docker.n8n.io/n8nio/n8n

